# SPDX-License-Identifier: GPL-3.0-only
# Arguments passed to linux/main.py by the freefitness systemd service.
# See `python main.py --help`.
#
#   --bike-id N        Keiser M3i bike ID shown on the bike's console
#   --protocols LIST   ant, ble, or ant,ble
#   --mock             ignore the bike, generate simulated power
#   --ant-driver TYPE  usb2 (Garmin ANT-USB / ANT-USBm) or usb1 (serial)
#
# Default is the simulator so a fresh install starts up without a bike.
FREEFITNESS_ARGS="--mock --protocols ble"
