# SPDX-License-Identifier: GPL-3.0-only
# Installed to /etc/systemd/system/ktog.service by install-rpi.sh,
# which substitutes @LINUX_DIR@ and @VENV_DIR@ with the real paths.
[Unit]
Description=Keiser to Garmin bike data bridge
Documentation=https://github.com/solufi/keiserTOgarmin
# BLE output needs a registered BlueZ adapter on the system bus.
Requires=bluetooth.service
After=bluetooth.service network.target
# The bike may be powered off; the bridge idles rather than exiting, so a
# rapid crash loop means a real fault. Give up after 5 failures in 60 s.
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
# Root is required for two reasons: registering GATT services and a pairing
# agent with BlueZ over the system D-Bus, and resetting the ANT+ USB device.
User=root
WorkingDirectory=@LINUX_DIR@
# stdout is a pipe here, so Python block-buffers it and telemetry only reaches
# the journal in 8 KiB bursts, making `journalctl -f` look dead.
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/default/ktog
ExecStart=@VENV_DIR@/bin/python main.py $KTOG_ARGS
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
