# Clé secrète Stripe (sk_test_… en test, sk_live_… en production).
# Sans elle, le site s'affiche mais le bouton d'achat renvoie une erreur explicite.
STRIPE_SECRET_KEY=

# Secret de signature du webhook (whsec_…), donné par `stripe listen` ou par le
# tableau de bord Stripe pour l'endpoint /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# URL publique du site, utilisée pour les retours de paiement et le sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Mettre à true une fois Stripe Tax activé et l'immatriculation fiscale saisie.
STRIPE_AUTOMATIC_TAX=false

# Optionnel : les commandes payées y sont relayées (Zapier, Make, n8n, Slack…).
# Sans cette variable, elles sont journalisées côté serveur.
ORDER_WEBHOOK_URL=
